{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SFA3R: Build (main)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SFA3R: Build current branch",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Here"],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SFA3R: Build (main, no WIDE FORCED)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-ForceWideScreen:$false"],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SFA3R: Build and run (main)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Run"],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}
